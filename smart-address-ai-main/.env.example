# =============================================================================
# FRONTEND (Vite) — copy this file to .env.local and replace values
# =============================================================================
# In Cursor: duplicate this file, name it .env.local (same folder as package.json).
# Files named *.local are gitignored — good for secrets.
#
# Going LIVE: replace Clerk test key with pk_live_… and use LIVE Stripe price IDs
# (same price_… strings as STRIPE_PRICE_* in address-splitter-main/.env).

# --- Clerk (sign-in) — Dashboard → API Keys → Publishable key ---
# Paste from Clerk → Production → Publishable key (starts with pk_live_…)
VITE_CLERK_PUBLISHABLE_KEY=

# --- Stripe subscription prices (ONLY price_… IDs — NOT the secret key) ---
# Must match the recurring prices on the backend for Starter / Pro / Corporate.
VITE_STRIPE_PRICE_STARTER=price_REPLACE_ME
VITE_STRIPE_PRICE_PRO=price_REPLACE_ME
VITE_STRIPE_PRICE_CORPORATE=price_REPLACE_ME
VITE_STRIPE_PRICE_SCALE=price_REPLACE_ME

# Optional: if the API is not proxied via /api (local dev often uses proxy; production may need this)
# VITE_PARSER_API_URL=https://your-parser-api.example.com
