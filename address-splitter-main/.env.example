# =============================================================================
# BACKEND (parser API + Stripe) — copy this file to .env and replace values
# =============================================================================
# In Cursor: duplicate this file, name it .env (same folder as parse_api.py).
# NEVER commit .env (it is gitignored).
#
# Going LIVE: use your Stripe LIVE secret key and live price_… IDs (Dashboard → turn Test mode OFF).
# If you already have a .env with test keys, REPLACE those lines with live values.

# --- Stripe (required for Subscribe / billing / plan detection) ---
# Paste from Stripe Dashboard → Developers → API keys (never commit the real key to Git)
STRIPE_SECRET_KEY=

# Checkout: show “Add promotion code” (default true). Set false to hide.
# STRIPE_CHECKOUT_ALLOW_PROMOTION_CODES=true

# Optional: Billing Portal configuration id (bpc_…) if you use a custom portal in Stripe Dashboard.
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

# Optional: free trial length (days) for new Checkout subscriptions — Stripe has no “trial” toggle on existing prices.
# Remove or set 0 for production with no trial. Range 1–730.
# STRIPE_CHECKOUT_TRIAL_PERIOD_DAYS=14

# Recurring subscription prices (Live catalog → Product → Price ID)
STRIPE_PRICE_STARTER=price_REPLACE_ME
STRIPE_PRICE_PRO=price_REPLACE_ME
STRIPE_PRICE_CORPORATE=price_REPLACE_ME
STRIPE_PRICE_SCALE=price_REPLACE_ME

# Optional: only if you use a separate Enterprise price in Stripe
# STRIPE_PRICE_ENTERPRISE=price_REPLACE_ME
# STRIPE_ENTERPRISE_MONTHLY_CAP=15000

# Metered overage (fill with live metered price_… IDs) — see smart-address-ai-main/STRIPE_OVERAGE.md
STRIPE_PRICE_OVERAGE_STARTER=price_REPLACE_ME
STRIPE_PRICE_OVERAGE_PRO=price_REPLACE_ME
STRIPE_PRICE_OVERAGE_CORPORATE=price_REPLACE_ME
STRIPE_PRICE_OVERAGE_SCALE=price_REPLACE_ME
# STRIPE_PRICE_OVERAGE_ENTERPRISE=price_REPLACE_ME

# --- Clerk (required so signed-in requests verify) ---
# Clerk Dashboard → your app → API Keys → JWT / JWKS + Secret key (same page)
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_JWKS_URL=https://REPLACE_ME.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev

# Webhook: Dashboard → Webhooks → Add endpoint → URL https://YOUR_API_HOST/webhooks/clerk
# Subscribe to user.created — copy the endpoint’s Signing secret (whsec_…)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_REPLACE_ME

# Production: comma-separated origins allowed to call this API from the browser (required for live site)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional
# USAGE_DB_PATH=/absolute/path/to/usage.db

# Support admin API (/admin/*) — generate e.g. openssl rand -hex 32 (min 32 chars). Never commit the real key.
# Send header: X-Admin-Key: <same value>
# ADMIN_API_KEY=

# Off by default. If set to 1, address_parsing_core prints verbose DEBUG traces (includes customer text) to stdout.
# Never enable on production — logs would retain address fragments. Local debugging only.
# ADDRESS_PARSE_DEBUG=

# Optional: Slack or Discord incoming webhook — page views and parse usage notifications (no PII).
# ACTIVITY_NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# ACTIVITY_NOTIFY_RATE_LIMIT_SECONDS=90
